<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechan.prw-metrics-slim</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@RELEASE_DIR@/scripts/run_prw_metrics.sh</string>
    <string>--repos</string>
    <string>@REPOS@</string>
    <string>--publish</string>
    <string>--roadmap-remote</string>
    <string>@ROADMAP_REMOTE@</string>
    <string>--roadmap-branch</string>
    <string>@ROADMAP_BRANCH@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>17</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>17</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/prw-metrics-slim.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/prw-metrics-slim.error.log</string>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
</dict>
</plist>
