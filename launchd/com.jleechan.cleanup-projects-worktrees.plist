<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechan.cleanup-projects-worktrees</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@HOME@/projects/jleechan-skills/scripts/cleanup-projects-worktrees.sh</string>
    <string>--clean</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/cleanup-projects-worktrees.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/cleanup-projects-worktrees.error.log</string>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
</dict>
</plist>
