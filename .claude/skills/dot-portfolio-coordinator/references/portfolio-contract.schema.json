{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DotPortfolioCoordinatorContract",
  "description": "External contract schemas for dot-portfolio-coordinator registry, review proposals, budget ledger, and notification bindings.",
  "definitions": {
    "TaskCompositeKey": {
      "type": "object",
      "properties": {
        "github_host": { "type": "string" },
        "repository": { "type": "string" },
        "source_namespace": { "type": "string" },
        "bead_id": { "type": "string" }
      },
      "required": ["github_host", "repository", "source_namespace", "bead_id"],
      "additionalProperties": false
    },
    "AudiencePolicy": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "array",
          "items": { "type": "string", "enum": ["model", "public", "internal"] }
        }
      },
      "additionalProperties": false
    },
    "SourceItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "type": { "type": "string", "enum": ["github_repo", "beads_store", "roadmap_beads"] },
        "github_host": { "type": "string" },
        "repository": { "type": "string" },
        "canonical_tracker": { "type": "string", "enum": ["beads", "github_issues", "unknown"] },
        "authority": { "type": "string", "enum": ["read_only", "authoritative_control"] },
        "host_binding": { "type": "string" },
        "owner": { "type": "string" },
        "freshness_budget_secs": { "type": "integer", "minimum": 0 },
        "collection_mode": { "type": "string", "enum": ["full_census", "incremental"] },
        "audience_policy": { "$ref": "#/definitions/AudiencePolicy" }
      },
      "required": ["id", "namespace", "type", "github_host", "repository", "canonical_tracker", "authority", "audience_policy"],
      "additionalProperties": false
    },
    "BudgetPolicy": {
      "type": "object",
      "properties": {
        "per_cycle_tokens": { "type": "integer", "minimum": 1 },
        "per_cycle_cost_usd": { "type": "number", "minimum": 0 },
        "daily_tokens": { "type": "integer", "minimum": 1 },
        "daily_cost_usd": { "type": "number", "minimum": 0 },
        "allowed_models": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["per_cycle_tokens", "per_cycle_cost_usd", "daily_tokens", "daily_cost_usd", "allowed_models"],
      "additionalProperties": false
    },
    "EndpointPolicy": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "allowed_endpoints": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "required": ["provider", "allowed_endpoints"],
      "additionalProperties": false
    },
    "SourcesRoster": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/SourceItem" }
        },
        "budget_policy": { "$ref": "#/definitions/BudgetPolicy" },
        "endpoint_policy": { "$ref": "#/definitions/EndpointPolicy" },
        "caller_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "designated_host": { "type": "string" }
      },
      "required": ["version", "sources"],
      "additionalProperties": false
    },
    "ProposalItem": {
      "type": "object",
      "properties": {
        "task_key": { "$ref": "#/definitions/TaskCompositeKey" },
        "source_version": { "type": "string" },
        "citations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "owner": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "status": { "type": "string" },
        "blocker": { "type": "string" },
        "next_action": { "type": "string" },
        "uncertainty": { "type": "string" }
      },
      "required": ["task_key", "source_version", "citations", "owner", "priority", "status", "next_action"],
      "additionalProperties": false
    },
    "ProposedMutation": {
      "type": "object",
      "properties": {
        "target_control_record_id": { "type": "string" },
        "action_type": { "type": "string", "enum": ["tracking_observation", "notification_request", "goal_intake"] },
        "append_note": { "type": "string" },
        "title": { "type": "string" },
        "owner": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "acceptance_criteria": { "type": "string" }
      },
      "required": ["target_control_record_id", "action_type", "append_note"],
      "additionalProperties": false
    },
    "ModelProposal": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "enum": [1] },
        "snapshot_id": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProposalItem" }
        },
        "mutations": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProposedMutation" }
        }
      },
      "required": ["schema_version", "snapshot_id", "items", "mutations"],
      "additionalProperties": false
    },
    "ReserveRequest": {
      "type": "object",
      "properties": {
        "caller_principal": { "type": "string" },
        "task_key": { "$ref": "#/definitions/TaskCompositeKey" },
        "grant_version": { "type": "string" },
        "action_id": { "type": "string" },
        "attempt_id": { "type": "string" },
        "currency": { "type": "string", "enum": ["USD"] },
        "max_cost": { "type": "number", "minimum": 0 }
      },
      "required": ["caller_principal", "task_key", "grant_version", "action_id", "attempt_id", "currency", "max_cost"],
      "additionalProperties": false
    },
    "ReserveReceipt": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["reserved", "rejected", "duplicate"] },
        "ledger_version": { "type": "integer" },
        "reservation_id": { "type": "string" },
        "accepted_amount": { "type": "number", "minimum": 0 },
        "remaining_ceiling": { "type": "number", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "required": ["status", "ledger_version", "reservation_id", "accepted_amount", "remaining_ceiling"],
      "additionalProperties": false
    },
    "SettleRequest": {
      "type": "object",
      "properties": {
        "caller_principal": { "type": "string" },
        "reservation_id": { "type": "string" },
        "actual_cost": { "type": "number", "minimum": 0 },
        "evidence_reference": { "type": "string" },
        "evidence_digest": { "type": "string" }
      },
      "required": ["caller_principal", "reservation_id", "actual_cost", "evidence_reference", "evidence_digest"],
      "additionalProperties": false
    },
    "SettleReceipt": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["settled", "rejected", "overrun_blocked", "already_settled"] },
        "ledger_version": { "type": "integer" },
        "reservation_id": { "type": "string" },
        "settled_amount": { "type": "number", "minimum": 0 },
        "remaining_ceiling": { "type": "number", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "required": ["status", "ledger_version", "reservation_id", "settled_amount", "remaining_ceiling"],
      "additionalProperties": false
    },
    "StatusRequest": {
      "type": "object",
      "properties": {
        "caller_principal": { "type": "string" },
        "reservation_id": { "type": "string" }
      },
      "required": ["caller_principal", "reservation_id"],
      "additionalProperties": false
    },
    "StatusReceipt": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["active", "settled", "unknown_reservation", "overrun"] },
        "ledger_version": { "type": "integer" },
        "reservation_id": { "type": "string" },
        "reserved_amount": { "type": "number", "minimum": 0 },
        "settled_amount": { "type": "number", "minimum": 0 },
        "remaining_ceiling": { "type": "number", "minimum": 0 }
      },
      "required": ["status", "ledger_version", "reservation_id", "reserved_amount", "settled_amount", "remaining_ceiling"],
      "additionalProperties": false
    },
    "NotificationBinding": {
      "type": "object",
      "properties": {
        "control_record_id": { "type": "string" },
        "action_id": { "type": "string" },
        "attempt_id": { "type": "string" },
        "account": { "type": "string" },
        "event_id": { "type": "string" },
        "kind": { "type": "string" },
        "message_sha256": { "type": "string" },
        "task_key": { "$ref": "#/definitions/TaskCompositeKey" },
        "grant_version": { "type": "string" },
        "control_entry_digest": { "type": "string" },
        "registered_at": { "type": "string" }
      },
      "required": [
        "control_record_id",
        "action_id",
        "attempt_id",
        "account",
        "event_id",
        "kind",
        "message_sha256",
        "task_key",
        "grant_version",
        "control_entry_digest",
        "registered_at"
      ],
      "additionalProperties": false
    }
  }
}
